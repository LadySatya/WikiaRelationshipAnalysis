// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/python
{
	"name": "WikiaAnalyzer",

	// Debian-based (glibc) image. The Python ML ecosystem -- torch, chromadb --
	// publishes prebuilt manylinux wheels only; musl/Alpine has none, so
	// sentence-transformers and ChromaDB cannot be installed there.
	"image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",

	// Flask visualization server (src/visualizer/server.py binds 0.0.0.0:8000)
	"forwardPorts": [8000],
	"portsAttributes": {
		"8000": {
			"label": "WikiaAnalyzer dashboard",
			"onAutoForward": "notify"
		}
	},

	// Create the venv and install the project with the RAG extra.
	// NOTE: the extra is named "rag" (not "llm") -- "llm" is a legacy stub that
	// omits chromadb and sentence-transformers.
	"postCreateCommand": "python -m venv .venv && .venv/bin/pip install --upgrade pip && .venv/bin/pip install -e '.[dev,rag,viz]'",

	"customizations": {
		"vscode": {
			"settings": {
				"python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python"
			},
			"extensions": [
				"ms-python.python"
			]
		}
	}
}
